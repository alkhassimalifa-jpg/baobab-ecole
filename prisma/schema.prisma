generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN // Equipe BAOBAB, hors ecole (schoolId = null)
  DIRECTOR
  DEPUTY_DIRECTOR
  SECRETARY
  ACCOUNTANT
  SURVEILLANT
  TEACHER
  PARENT
  STUDENT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum PeriodType {
  TRIMESTER
  SEMESTER
  CUSTOM
}

// ============================================================
// TENANT : ECOLE
// ============================================================

model School {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  logoUrl String?

  quarter  String?
  city     String?
  province String?

  phone    String?
  whatsapp String?
  email    String?

  primaryLanguage   String  @default("fr")
  secondaryLanguage String?
  currency          String  @default("XAF")

  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  academicYears AcademicYear[]
  auditLogs     AuditLog[]

  @@map("schools")
}

// ============================================================
// UTILISATEURS
// ============================================================

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  role     UserRole
  isActive Boolean  @default(true)

  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  lastLoginAt DateTime?

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]

  @@index([schoolId])
  @@map("users")
}

// ============================================================
// ANNEE SCOLAIRE
// ============================================================

model AcademicYear {
  id        String   @id @default(cuid())
  label     String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  periodType PeriodType @default(TRIMESTER)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, label])
  @@index([schoolId])
  @@map("academic_years")
}

// ============================================================
// JOURNAL D'AUDIT
// ============================================================

model AuditLog {
  id String @id @default(cuid())

  action     String
  entityType String?
  entityId   String?

  before Json?
  after  Json?

  ipAddress String?
  userAgent String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
