generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  PROMOTER
  DIRECTOR
  DEPUTY_DIRECTOR
  PEDAGOGICAL_HEAD
  SECRETARY
  ACCOUNTANT
  SURVEILLANT
  TEACHER
  PARENT
  STUDENT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum PeriodType {
  TRIMESTER
  SEMESTER
  CUSTOM
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  REPEATING
  TRANSFERRED
  WITHDRAWN
}

enum GuardianRelation {
  FATHER
  MOTHER
  LEGAL_GUARDIAN
  OTHER
}

enum GradeType {
  HOMEWORK
  QUIZ
  TEST
  EXAM
  ORAL
  PROJECT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED_ABSENCE
}

enum PaymentMode {
  CASH
  MOBILE_MONEY
  CHECK
  BANK_TRANSFER
}

// ============================================================
// TENANT : ECOLE
// ============================================================

model School {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  logoUrl String?

  quarter  String?
  city     String?
  province String?

  phone    String?
  whatsapp String?
  email    String?

  primaryLanguage   String  @default("fr")
  secondaryLanguage String?
  currency          String  @default("XAF")

  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  academicYears AcademicYear[]
  auditLogs     AuditLog[]
  classes       Class[]
  subjects      Subject[]
  students      Student[]
  feeTypes      FeeType[]

  @@map("schools")
}

// ============================================================
// UTILISATEURS
// ============================================================

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  role     UserRole
  isActive Boolean  @default(true)

  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  firstName String?
  lastName  String?
  phone     String?

  lastLoginAt DateTime?

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs           AuditLog[]
  taughtClasses       Class[]              @relation("MainTeacher")
  guardianOf          Guardian[]
  gradesRecorded      Grade[]              @relation("GradeRecordedBy")
  attendanceRecords   Attendance[]         @relation("AttendanceRecordedBy")
  paymentsRecorded    Payment[]            @relation("PaymentRecordedBy")
  teachingAssignments TeachingAssignment[] @relation("TeacherAssignments")

  @@index([schoolId])
  @@map("users")
}

// ============================================================
// ANNEE SCOLAIRE
// ============================================================

model AcademicYear {
  id        String   @id @default(cuid())
  label     String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  periodType PeriodType @default(TRIMESTER)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes     Class[]
  enrollments Enrollment[]
  feeTypes    FeeType[]

  @@unique([schoolId, label])
  @@index([schoolId])
  @@map("academic_years")
}

// ============================================================
// CLASSES ET MATIERES
// ============================================================

model Class {
  id       String  @id @default(cuid())
  name     String // ex: "3eme B"
  level    String // ex: "3eme" - texte libre, personnalisable par ecole
  room     String?
  capacity Int?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  mainTeacherId String?
  mainTeacher   User?   @relation("MainTeacher", fields: [mainTeacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments         Enrollment[]
  teachingAssignments TeachingAssignment[]

  @@index([schoolId])
  @@index([academicYearId])
  @@map("classes")
}

model Subject {
  id   String @id @default(cuid())
  name String // ex: "Mathematiques"

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  grades              Grade[]
  teachingAssignments TeachingAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("subjects")
}

// ============================================================
// ELEVES
// ============================================================

model Student {
  id        String @id @default(cuid())
  matricule String @unique // ex: BAOBAB-2026-000145

  firstName   String
  lastName    String
  birthDate   DateTime?
  birthPlace  String?
  gender      String?
  nationality String?
  photoUrl    String?
  address     String?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians   Guardian[]
  enrollments Enrollment[]

  @@index([schoolId])
  @@map("students")
}

// Lien Eleve <-> Parent (plusieurs enfants par parent, plusieurs responsables par eleve)
model Guardian {
  id               String           @id @default(cuid())
  relation         GuardianRelation
  isPrimaryContact Boolean          @default(false)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, userId])
  @@index([studentId])
  @@index([userId])
  @@map("guardians")
}

// ============================================================
// INSCRIPTION ANNUELLE (coeur de l'historique par annee)
// ============================================================

model Enrollment {
  id     String           @id @default(cuid())
  status EnrollmentStatus @default(ACTIVE)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades      Grade[]
  attendances Attendance[]
  payments    Payment[]

  @@unique([studentId, academicYearId])
  @@index([classId])
  @@index([academicYearId])
  @@map("enrollments")
}

// ============================================================
// NOTES
// ============================================================

model Grade {
  id          String    @id @default(cuid())
  type        GradeType
  value       Float
  maxValue    Float     @default(20)
  coefficient Float     @default(1)
  date        DateTime
  isPublished Boolean   @default(false)

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  recordedById String?
  recordedBy   User?   @relation("GradeRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([enrollmentId])
  @@index([subjectId])
  @@map("grades")
}

// ============================================================
// PRESENCES
// ============================================================

model Attendance {
  id     String           @id @default(cuid())
  status AttendanceStatus
  date   DateTime

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  recordedById String?
  recordedBy   User?   @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([enrollmentId])
  @@map("attendances")
}

// ============================================================
// FINANCE - GRILLE TARIFAIRE ET PAIEMENTS (manuel uniquement)
// ============================================================

model FeeType {
  id     String @id @default(cuid())
  name   String // ex: "Frais de scolarite - Trimestre 1"
  amount Float

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  payments Payment[]

  @@index([schoolId])
  @@index([academicYearId])
  @@map("fee_types")
}

model Payment {
  id            String      @id @default(cuid())
  receiptNumber String      @unique // ex: BAOBAB-000152
  amount        Float
  mode          PaymentMode
  paidAt        DateTime    @default(now())

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  feeTypeId String
  feeType   FeeType @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)

  recordedById String?
  recordedBy   User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([enrollmentId])
  @@index([feeTypeId])
  @@map("payments")
}

// ============================================================
// JOURNAL D'AUDIT
// ============================================================

model AuditLog {
  id String @id @default(cuid())

  action     String
  entityType String?
  entityId   String?

  before Json?
  after  Json?

  ipAddress String?
  userAgent String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model TeachingAssignment {
  id String @id @default(cuid())

  teacherId String
  teacher   User   @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teacherId, classId, subjectId])
  @@index([teacherId])
  @@index([classId])
  @@map("teaching_assignments")
}
